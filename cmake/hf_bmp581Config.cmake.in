# Package configuration for the HF-BMP581 driver (generated by CMake).
#
# After `cmake --install`:
#   find_package(hf_bmp581 CONFIG REQUIRED)
#   target_link_libraries(my_app PRIVATE hf::bmp581)
@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/hf_bmp581Targets.cmake")

check_required_components(hf_bmp581)
